{
	"name": "gdou-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "GDOU agent - a custom agent built on the pi kernel (pi-ai + pi-agent-core + pi-coding-agent)",
	"author": "GDOU agent",
	"main": "dist/main.cjs",
	"piConfig": {
		"name": "gdou",
		"configDir": ".gdou-agent"
	},
	"scripts": {
		"sync-paths": "node scripts/sync-pi-paths.mjs",
		"build": "node scripts/build.mjs",
		"fetch:tools": "node scripts/fetch-tools.mjs",
		"gui": "npm run build && node scripts/launch-gui.mjs",
		"package": "npm run build && npm run fetch:tools && node scripts/package.mjs",
		"package:dir": "npm run build && npm run fetch:tools && node scripts/package.mjs --dir",
		"shortcut": "node scripts/shortcut.mjs",
		"check:gui": "node scripts/gui-check.mjs",
		"check:renderer": "node scripts/renderer-check.mjs",
		"run": "node --import ./scripts/pi-env.mjs node_modules/tsx/dist/cli.mjs --tsconfig ./tsconfig.json src/cli.ts",
		"smoke": "node --import ./scripts/pi-env.mjs node_modules/tsx/dist/cli.mjs --tsconfig ./tsconfig.json scripts/smoke.ts",
		"check:tui": "node --import ./scripts/pi-env.mjs node_modules/tsx/dist/cli.mjs --tsconfig ./tsconfig.json scripts/tui-check.ts",
		"typecheck": "node node_modules/@typescript/native-preview/bin/tsgo.js --noEmit -p ./tsconfig.json",
		"check:tools": "node --import ./scripts/pi-env.mjs node_modules/tsx/dist/cli.mjs --tsconfig ./tsconfig.json scripts/tool-check.ts",
		"check": "npm run check:vendor && npm run typecheck && npm run smoke && npm run check:tui && npm run check:tools && npm run check:renderer",
		"vendor:pi": "node scripts/vendor-pi.mjs",
		"check:vendor": "node scripts/check-vendor.mjs"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"electron": "^44.4.3",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"tsx": "4.22.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.124.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@google/genai": "2.21.0",
		"@mozilla/readability": "0.6.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@smithy/node-http-handler": "4.12.1",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"get-east-asian-width": "1.6.0",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"linkedom": "0.18.13",
		"marked": "18.0.11",
		"minimatch": "10.2.6",
		"openai": "6.40.0",
		"partial-json": "0.1.7",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	}
}
