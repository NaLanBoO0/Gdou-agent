{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gdouwork",
  "version": "0.1.0",
  "identifier": "cn.gdouwork.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/dev-desktop.mjs --dev-server",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node ../scripts/dev-desktop.mjs --build-assets",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gdouwork",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:7438; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bridge.exe"
    ]
  }
}