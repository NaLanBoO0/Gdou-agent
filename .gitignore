node_modules/

# Secrets. Nothing in this project needs a committed key: credentials live in
# `~/.gdou-agent/auth.json` (outside the repo, 0600) or in the environment.
# These entries are defensive — a stray `.env` from a debugging session is the
# most likely way a key reaches a commit, and it is invisible in `git status`
# once it is tracked.
.env
.env.*
*.local

# Build output. Regenerated by `npm run build`.
dist/

# Installer output. Regenerated by `npm run package`.
release/

# Self-contained bridge binary produced by `scripts/build-bridge-sea.mjs`.
# Bundled by Tauri via `resources`, never committed.
shell/src-tauri/resources/*.exe
shell/src-tauri/resources/bin/

# Tauri build output and generated schemas. Regenerated on demand.
shell/src-tauri/target/
shell/src-tauri/gen/

# Downloaded third-party binaries. Regenerated by `npm run fetch:tools`.
# Only the binaries are ignored: `vendor/pi` is vendored source and belongs in
# the repository, which is what lets the manifest guard it.
vendor/bin/

# Scratch space for the screenshot tooling. `.shots` is where it writes; the
# kept screenshots live in `docs/screenshots/` and are committed.
.shots/

# Local agent workspace data (session-to-session notes). Not part of the
# product; committing it would only add churn to every diff.
.workbuddy/

# Editor and OS noise. Not harmful, but it clutters every diff and the entries
# are free.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
